# Copy to .env and fill in. .env is gitignored; never commit real values.
# Create an app at https://www.mixcloud.com/developers/create/ to get these.
MIXCLOUD_CLIENT_ID=
MIXCLOUD_CLIENT_SECRET=

# Optional. Leave empty to have Mixcloud show the authorization code on
# screen, or use http://localhost:8765/callback (registered on your app) to
# have "auth login" capture it automatically.
MIXCLOUD_REDIRECT_URI=

# Written by "soundmix-cli auth login".
MIXCLOUD_ACCESS_TOKEN=

# Optional overrides, e.g. to point at a local API stub in tests.
# MIXCLOUD_API_URL=https://api.mixcloud.com/
# MIXCLOUD_OAUTH_URL=https://www.mixcloud.com/oauth/
